{
  "name": "@weems/api",
  "version": "0.1.0",
  "private": true,
  "description": "Weems REST API",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate-cli.ts",
    "invite": "node --env-file-if-exists=.env src/modules/accounts/invite-cli.ts",
    "alpha-report": "node --env-file-if-exists=.env src/modules/alpha/report-cli.ts",
    "airports:update": "node src/modules/airports/update-cli.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.20",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@weems/contrats": "workspace:*",
    "better-auth": "1.7.20",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
