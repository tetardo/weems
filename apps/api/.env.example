# Copy to .env for `pnpm dev` outside Docker. Values below are the development defaults.
WEEMS_ENV=development
PORT=3000
DATABASE_URL=postgres://weems:weems@localhost:5432/weems
WEEMS_DEV_TOKEN=dev-token
WEEMS_MIN_TRACKER_VERSION=0.1.0
WEEMS_MIGRATE_ON_START=true
TEST_DATABASE_URL=postgres://weems:weems@localhost:5432/weems_test
# J3 accounts: address of the site (serves /api/auth, proxied to the API) and of the API (audience of tracker tokens).
WEEMS_SITE_URL=http://localhost:3001
WEEMS_API_URL=http://localhost:3000
# 32 characters or more; mandatory in production (generate with: openssl rand -base64 32).
# WEEMS_AUTH_SECRET=
# Addresses of the site's server, allowed to pass on the visitor's address (rate limits of public pages).
WEEMS_TRUSTED_PROXIES=127.0.0.1,::1
