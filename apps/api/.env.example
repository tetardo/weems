# Copy to .env for `pnpm dev` outside Docker. Values below are the development defaults.
WEEMS_ENV=development
PORT=3000
DATABASE_URL=postgres://weems:weems@localhost:5432/weems
WEEMS_DEV_TOKEN=dev-token
WEEMS_MIN_TRACKER_VERSION=0.1.0
WEEMS_MIGRATE_ON_START=true
TEST_DATABASE_URL=postgres://weems:weems@localhost:5432/weems_test
