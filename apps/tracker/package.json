{
  "name": "@weems/tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Weems flight tracker: core, connectors, recorder, sender",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p src/app/window/tsconfig.json",
    "generate-flight": "node tools/generate-flights/cli.ts",
    "airports:simulated": "node tools/generate-flights/airports/update-cli.ts",
    "simulate": "node tools/simulate/cli.ts",
    "fly": "node tools/fly/cli.ts",
    "app": "pnpm app:build && electron dist/app",
    "app:build": "node scripts/build-app.ts",
    "app:package": "pnpm app:build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@weems/contrats": "workspace:*",
    "electron-updater": "6.8.11",
    "node-simconnect": "4.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "main": "dist/app/main.cjs"
}
